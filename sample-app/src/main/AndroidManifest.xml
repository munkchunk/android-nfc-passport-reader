<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      ML Kit's text recognition pulls in Google's datatransport library, which
      requests network access to send usage telemetry. The app never needs the
      network: the text model is bundled and passport data stays on the device.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SampleApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PassportReaderSample">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PassportReaderSample">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Deliberately no TECH_DISCOVERED filter. The reader drives NFC
              through ReaderMode, which is disabled the moment a read succeeds -
              while the passport is still on the phone. The filter would then
              match and relaunch this Activity into the NFC service's task,
              destroying the result the user is trying to read.
            -->
        </activity>
    </application>

</manifest>
