<?xml version="1.0" encoding="utf-8"?>
<!--
  Every word the sample app shows. The library has its own strings.xml for the
  copy it owns - the read failures - which this app resolves through
  PassportReadException.titleRes/messageRes rather than restating here.

  Kept in the order the user meets them: entry, scan, read, result.
-->
<resources>

    <string name="app_name">Passport Reader</string>

    <!-- Top app bar. The scan screen runs full bleed and has no bar. -->
    <string name="bar_mrz_entry">Passport reader</string>
    <string name="bar_reading">Reading passport</string>
    <string name="bar_result">Passport data</string>

    <!-- ============================ Entry ============================ -->

    <string name="entry_title">Unlock the chip</string>
    <string name="entry_intro">The MRZ (bottom 2 rows of letters and numbers) on the photo page holds the key. Scan the start of it, or type the three fields yourself.</string>
    <string name="entry_scan">Scan with camera</string>
    <string name="entry_or_type">OR TYPE THEM</string>
    <string name="entry_read">Read passport</string>

    <string name="entry_warning_no_nfc">This device has no NFC hardware, so a passport cannot be read.</string>
    <string name="entry_warning_nfc_off">NFC is switched off. Turn it on to read a passport.</string>
    <string name="entry_open_nfc_settings">Open NFC settings</string>

    <string name="field_document_number">Document number</string>
    <string name="field_date_of_birth_entry">Date of birth (YYMMDD)</string>
    <string name="field_expiry_date_entry">Expiry date (YYMMDD)</string>

    <!-- Field names, used inside validation messages. -->
    <string name="field_name_date_of_birth">Date of birth</string>
    <string name="field_name_expiry_date">Expiry date</string>

    <!-- Validation. MrzFieldError maps to these. -->
    <string name="validation_required">Required</string>
    <string name="validation_document_too_long">At most 9 characters</string>
    <string name="validation_document_alphabet">Only A-Z, 0-9 and &lt; are allowed</string>
    <string name="validation_date_length">%1$s must be 6 digits (YYMMDD)</string>
    <string name="validation_digits_only">Digits only</string>
    <string name="validation_month_range">Month must be 01-12</string>
    <string name="validation_day_range">Day must be 01-31</string>

    <!-- Debug-only shortcuts; never present in a release build. -->
    <string name="debug_shortcuts">DEBUG SHORTCUTS</string>
    <string name="debug_previous">Previous (%1$s)</string>
    <string name="debug_example">Example</string>

    <!-- ============================ Scan ============================= -->

    <string name="scan_hint_searching">Line the start of the MRZ up with the left of the box</string>
    <string name="scan_hint_move_left">Move left - the start of the row is off the edge</string>
    <string name="scan_hint_move_right">Move right to bring in more of the row</string>
    <string name="scan_hint_move_back">Move back a little - the row is wider than the box</string>
    <string name="scan_hint_unclear">Reading - hold steady, move a little closer or flatten the page</string>
    <string name="scan_hint_confirming">Got it - checking</string>
    <string name="scan_captured">Got it</string>
    <string name="scan_enter_by_hand">Enter details by hand</string>

    <string name="permission_camera_title">Camera access needed</string>
    <string name="permission_camera_body">The camera reads the MRZ - row of letters and numbers along the bottom of the photo page. Nothing is recorded or sent anywhere.</string>
    <string name="permission_camera_allow">Allow camera</string>

    <!-- ============================ Read ============================= -->

    <string name="read_heading_waiting">Rest the phone on your passport</string>
    <string name="read_heading_reading">Keep it there</string>
    <string name="read_heading_done">Done</string>
    <string name="read_still_waiting_title">No passport found yet</string>
    <string name="read_body_still_waiting">Lift the phone and lay it flat again, on the other cover, then on the photo page. If it is still not found, cancel and start again.</string>
    <string name="read_body_waiting">Lay it flat on the front or back cover and hold still. If nothing happens after a few seconds, try the other side, then the photo page.</string>
